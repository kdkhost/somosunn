APP_NAME=UNN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unn_db
DB_USERNAME=root
DB_PASSWORD=

# Payment placeholders
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
PAGSEGURO_EMAIL=
PAGSEGURO_TOKEN=

# Socialite placeholders
GOOGLE_CLIENT_ID=seu-id
GOOGLE_CLIENT_SECRET=seu-secret
GOOGLE_REDIRECT={APP_URL}/auth/callback/google

FACEBOOK_CLIENT_ID=seu-id
FACEBOOK_CLIENT_SECRET=seu-secret
FACEBOOK_REDIRECT={APP_URL}/auth/callback/facebook

LINKEDIN_CLIENT_ID=seu-id
LINKEDIN_CLIENT_SECRET=seu-secret
LINKEDIN_REDIRECT={APP_URL}/auth/callback/linkedin

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="UNN"

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# PWA
PWA_ENABLED=true
PWA_NAME="UNN"
PWA_SHORT_NAME="UNN"
PWA_DESCRIPTION="Comunidade de networking UNN"
PWA_THEME_COLOR=#5B21B6
PWA_BG_COLOR=#ffffff

# Upload limits
VIDEO_MAX_MB=1024
DOCUMENT_MAX_MB=50
ALLOWED_VIDEO_FORMATS=mp4,webm,mkv
ALLOWED_DOCUMENT_FORMATS=pdf,docx,pptx
