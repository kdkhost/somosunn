APP_NAME=UNN
APP_ENV=local
APP_KEY=
APP_DEBUG=true
DEMO_MODE=false
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=unn_db
DB_USERNAME=root
DB_PASSWORD=

# Queues (Shared Hosting / cPanel)
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

# Payment placeholders
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=

# SumUp
SUMUP_API_KEY=
SUMUP_CLIENT_ID=
SUMUP_CLIENT_SECRET=
SUMUP_MERCHANT_CODE=
SUMUP_ENV=sandbox
SUMUP_FEE_PERCENTAGE=2.75
SUMUP_FEE_FIXED=0
SUMUP_PASS_FEE=false
SUMUP_WEBHOOK_SECRET=

# Socialite placeholders
GOOGLE_CLIENT_ID=seu-id
GOOGLE_CLIENT_SECRET=seu-secret
GOOGLE_REDIRECT={APP_URL}/auth/callback/google

FACEBOOK_CLIENT_ID=seu-id
FACEBOOK_CLIENT_SECRET=seu-secret
FACEBOOK_REDIRECT={APP_URL}/auth/callback/facebook

LINKEDIN_CLIENT_ID=seu-id
LINKEDIN_CLIENT_SECRET=seu-secret
LINKEDIN_REDIRECT={APP_URL}/auth/callback/linkedin

# reCAPTCHA v3 (Formulário de Contato)
RECAPTCHA_V3_SITE_KEY=
RECAPTCHA_V3_SECRET_KEY=
RECAPTCHA_V3_MIN_SCORE=0.5

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME={APP_NAME}

# AWS S3 (optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=

# PWA
PWA_ENABLED=true
PWA_NAME={APP_NAME}
PWA_SHORT_NAME={APP_NAME}
PWA_DESCRIPTION="Comunidade de networking UNN"
PWA_THEME_COLOR=#5B21B6
PWA_BG_COLOR=#ffffff

# Upload limits
VIDEO_MAX_MB=1024
DOCUMENT_MAX_MB=50
ALLOWED_VIDEO_FORMATS=mp4,webm,mkv
ALLOWED_DOCUMENT_FORMATS=pdf,docx,pptx
VIDEO_HLS_ENABLED=true
VIDEO_HLS_ASYNC=true
VIDEO_HLS_SCHEDULER_LIMIT=2
VIDEO_FFMPEG_BINARY=ffmpeg
VIDEO_PHP_BINARY=php
VIDEO_HLS_SEGMENT_SECONDS=6
VIDEO_HLS_CRF=25
VIDEO_HLS_PRESET=veryfast

# Analytics / Visitas (opcional)
VISITOR_LOGS_ENABLED=true
VISITOR_LOGS_STORE_IP=false
VISITOR_LOGS_DEDUPE_SECONDS=60
IPINFO_TOKEN=

# Cron interno (fallback sem cron do cPanel; depende de tráfego)
INTERNAL_CRON_ENABLED=true
INTERNAL_CRON_MIN_INTERVAL_SECONDS=60
INTERNAL_CRON_RUN_QUEUE_WORKER=true

# WAF (Web Application Firewall) — ver config/waf.php
WAF_ENABLED=false
WAF_MODE=detection-only
WAF_FAIL_POLICY=open
WAF_THRESHOLD_MONITOR=20
WAF_THRESHOLD_CHALLENGE=50
WAF_THRESHOLD_BLOCK=80
WAF_RETENTION_ALLOWED=7
WAF_RETENTION_MONITORED=30
WAF_RETENTION_CHALLENGED=90
WAF_RETENTION_BLOCKED=180
WAF_AUTO_BLOCK_ENABLED=false
WAF_AUTO_BLOCK_WINDOW_MINUTES=15
WAF_AUTO_BLOCK_THRESHOLD=100
WAF_AUTO_BLOCK_DURATION_HOURS=24
WAF_RL_DEFAULT_LIMIT=300
WAF_RL_DEFAULT_WINDOW=60
WAF_RL_LOGIN_LIMIT=10
WAF_RL_LOGIN_WINDOW=60
WAF_RL_API_LIMIT=120
WAF_RL_API_WINDOW=60
WAF_RL_WEBHOOK_LIMIT=600
WAF_RL_WEBHOOK_WINDOW=60
WAF_ALLOWED_SAMPLING_RATIO=0.0
WAF_SAMPLE_MAX_BYTES=2048
WAF_REGEX_TIMEOUT_MS=20
WAF_MASK_EMAILS=false
WAF_MASK_PANS=true
WAF_MASK_CPF=true
WAF_MASK_CNPJ=true

# Sessão segura (produção)
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_LIFETIME=120

# Manutenção / rotas sensíveis
MAINTENANCE_SECRET=
