{
  "name": "unn/community-platform",
  "description": "Scaffold Laravel 12 para UNN - plataforma de networking e social login",
  "type": "project",
  "require": {
    "php": "^8.1|^8.2|^8.3|^8.4",
    "laravel/framework": "^10.0",
    "laravel/socialite": "^5.0",
    "laravel/sanctum": "^3.0",
    "phpmailer/phpmailer": "^6.8",
    "mercadopago/dx-php": "^2.6",
    "dompdf/dompdf": "^2.0",
    "doctrine/dbal": "^3.10",
    "league/flysystem-aws-s3-v3": "^3.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Seeders\\": "database/seeders/",
      "Database\\Factories\\": "database/factories/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ]
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require-dev": {
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "10.5",
    "giorgiosironi/eris": "^0.14"
  },
  "config": {
    "audit": {
      "ignore": ["PKSA-z3gr-8qht-p93v"]
    }
  }
}
