AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # === SECURITY: Block access to sensitive files and directories ===
    # Block .env files
    RewriteRule ^\.env - [F,L]
    RewriteRule \.env$ - [F,L]

    # Block .git directory
    RewriteRule ^\.git - [F,L]

    # Block .htaccess and .htpasswd
    RewriteRule ^\.ht - [F,L]

    # Block composer files
    RewriteRule ^composer\.(json|lock)$ - [F,L]

    # Block package files
    RewriteRule ^package(-lock)?\.json$ - [F,L]

    # Block storage/logs access
    RewriteRule ^storage/ - [F,L]

    # Block vendor directory direct access
    RewriteRule ^vendor/ - [F,L]

    # Block config directory
    RewriteRule ^config/ - [F,L]

    # Block database directory
    RewriteRule ^database/ - [F,L]

    # === END SECURITY ===

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Block access to hidden files (dotfiles)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block access to sensitive file types
<FilesMatch "\.(env|git|gitignore|gitmodules|bak|sql|log|ini|conf|dist|yml|yaml|lock)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # CORS headers for external resources (prevent CORB blocking)
    <FilesMatch "\.(css|js|woff|woff2|ttf|eot|svg)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Access-Control-Allow-Methods "GET, OPTIONS"
        Header set Access-Control-Allow-Headers "Content-Type"
    </FilesMatch>
    
    # Ensure correct Content-Type for CSS and JS
    <FilesMatch "\.css$">
        Header set Content-Type "text/css; charset=utf-8"
    </FilesMatch>
    
    <FilesMatch "\.js$">
        Header set Content-Type "application/javascript; charset=utf-8"
    </FilesMatch>
    
    # Allow caching for vendor assets (CSS, JS, fonts, images)
    <FilesMatch "\.(css|js|woff|woff2|ttf|eot|svg|jpg|jpeg|png|gif|ico)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>
    
    # No cache for HTML and PHP
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "max-age=0, private, no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
