AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Curriculos contem dados pessoais e so podem ser baixados por rota autenticada.
    RewriteRule ^storage/resumes(?:/|$) - [R=404,L,NC]

    # === SECURITY: Block access to sensitive files and directories ===
    # Block .env files
    RewriteRule ^\.env - [F,L]
    RewriteRule \.env$ - [F,L]

    # Block .git directory
    RewriteRule ^\.git - [F,L]

    # Block .htaccess and .htpasswd
    RewriteRule ^\.ht - [F,L]

    # Block composer files
    RewriteRule ^composer\.(json|lock)$ - [F,L]

    # Block package files
    RewriteRule ^package(-lock)?\.json$ - [F,L]

    # Bloquear apenas scripts/arquivos sensiveis dentro de public/vendor (assets JS/CSS/fontes permanecem publicos)
    RewriteRule ^vendor/.*\.(?:php|phtml|phar|sh|sql|json|lock|md|yml|yaml|bak|env)$ - [F,L,NC]

    # Block config directory
    RewriteRule ^config/ - [F,L]

    # Block database directory
    RewriteRule ^database/ - [F,L]

    # === END SECURITY ===

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Responder preflight CORS OPTIONS para ativos estaticos / PDFs / midias do CDN
    RewriteCond %{REQUEST_METHOD} ^OPTIONS$
    RewriteRule \.(?:css|js|woff|woff2|ttf|eot|svg|pdf|jpg|jpeg|png|webp|gif|ico|mp4|webm|ogg|mp3|wav)$ - [R=204,L,NC]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Block access to hidden files (dotfiles)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Block access to sensitive file types
<FilesMatch "\.(env|git|gitignore|gitmodules|bak|sql|log|ini|conf|dist|yml|yaml|lock)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # CORS headers (always inclui 204 OPTIONS e 206 Partial Content para PDF.js/CDN)
    <FilesMatch "\.(css|js|woff|woff2|ttf|eot|svg|pdf|jpg|jpeg|png|webp|gif|ico|mp4|webm|ogg|mp3|wav)$">
        Header always set Access-Control-Allow-Origin "*"
        Header always set Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        Header always set Access-Control-Allow-Headers "Range, Content-Type, Accept, Origin"
        Header always set Access-Control-Expose-Headers "Accept-Ranges, Content-Range, Content-Length, Content-Type"
    </FilesMatch>
    
    # Ensure correct Content-Type for CSS and JS
    <FilesMatch "\.css$">
        Header set Content-Type "text/css; charset=utf-8"
    </FilesMatch>
    
    <FilesMatch "\.js$">
        Header set Content-Type "application/javascript; charset=utf-8"
    </FilesMatch>
    
    # Allow caching for vendor assets, PDFs, fonts, images and media
    <FilesMatch "\.(css|js|woff|woff2|ttf|eot|svg|pdf|jpg|jpeg|png|webp|gif|ico|mp4|webm)$">
        Header set Cache-Control "max-age=604800, public"
    </FilesMatch>
    
    # No cache apenas para HTML estatico (o Laravel controla Cache-Control nas rotas via index.php; evita setifempty no LiteSpeed)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=0, private, no-cache, no-store, must-revalidate"
    </FilesMatch>
</IfModule>
