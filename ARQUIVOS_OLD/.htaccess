<IfModule mod_headers.c>
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
</IfModule>

DirectoryIndex install-check.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # rotas do backend passam pelo public/index.php
    RewriteCond %{REQUEST_URI} ^/backend
    RewriteCond %{REQUEST_URI} !^/backend/public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^backend(?:/(.*))?$ /backend/public/index.php/$1 [L,QSA]

    # enviar /install para o instalador
    RewriteRule ^install/?$ /install-check.php [L]

    # redirecionar tudo fora de /backend ao instalador
    RewriteCond %{REQUEST_URI} !^/backend/
    RewriteCond %{REQUEST_URI} !^/install-check.php$
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ /install-check.php [L]
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 1 hour"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
</IfModule>
