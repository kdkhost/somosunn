
# Laravel padrão
/vendor/
/node_modules/
/.env
/public/storage/
/storage/
/storage/*.key
/storage/app/public/
/storage/logs/
.idea/
*.log
.DS_Store
.env.*.local
.phpunit.result.cache
/.phpunit.cache/
/public/hot
/public/build/
/public/mix-manifest.json
/public/js/*.map

# Instrucoes locais (nao enviar para o servidor)
AGENTS.md
.kiro/
/public/css/*.map
npm-debug.log
composer.lock

# Configurações locais de editor (contêm tokens sensíveis)
.cursor/
